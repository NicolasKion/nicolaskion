# The production site block. The shared Caddy serves a copy of it from the
# infra repo (TimKunze96/infra, sites/nicolaskion.dev.caddy); change both.
# Same routing as Caddyfile.dev: keep the path list in sync with
# frontend/proxy-paths.ts.

nicolaskion.dev {
	header {
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options nosniff
	}

	# The tournament-tool update feed. Installed clients have this URL
	# compiled in, so it is served straight from the host directory
	# /opt/nicolaskion/update-feed (mounted read-only into the Caddy
	# container at /srv/nicolaskion/update-feed), independent of the app
	# containers. Archives and signatures go out as octet-stream, not
	# application/gzip, and nothing here is compressed on the way.
	handle_path /storage/tt-8d20886697466b8297bb6d6e1735fa53/* {
		root * /srv/nicolaskion/update-feed
		@binary path *.gz *.sig
		header @binary Content-Type application/octet-stream
		file_server
	}

	handle {
		encode zstd gzip
		@axum path /api/* /storage/* /up
		reverse_proxy @axum nicolaskion-api:3000

		reverse_proxy nicolaskion-frontend:3000
	}
}

www.nicolaskion.dev {
	redir https://nicolaskion.dev{uri} permanent
}
