# Copy to .env. Every value has a working local default; without a token
# and a character id the page renders without GitHub and the EVE dossier.

# The api listen address and logs.
# BIND_ADDR=127.0.0.1:3000
# RUST_LOG=info

# The name in the page props and the health page title.
# APP_NAME=Nicolas Kion

# GitHub: a token that reads the repositories of the owner and their
# organizations (private ones only feed the stack languages).
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com

# The EVE Online pilot in the dossier.
# EVE_CHARACTER_ID=95569887
# ESI_URL=https://esi.evetech.net

# The composed stack only: a local copy of the tournament-tool update feed
# for Caddy to serve (an empty directory by default).
# UPDATE_FEED_DIR=./storage/update-feed
